# Python environments (rebuild from environment/; see README)
/lidar-icp/
/.venv/
__pycache__/
*.pyc
*.egg-info/

# Data: large and publicly re-fetchable via scripts/fetch_tile.py
/data/
# --- tracked exception ------------------------------------------------------------------
# The control-mark DERIVED TABLES (~6.5 MB) are tracked on purpose, so that
# analysis/control_lowveg_offset.py reproduces from a bare clone in ~60 s instead of
# needing the ~55-minute EPT acquisition first. Git needs the parent dirs un-ignored
# before a file inside them can be re-included, hence the ladder.
# The 1.5 GB of point-cloud boxes under data/derived/control_boxes/ stay UNTRACKED.
!/data/
/data/*
!/data/derived/
/data/derived/*
!/data/derived/control_cover.csv
!/data/derived/control_ngv_exact.csv
!/data/derived/control_structure/
!/data/derived/control_structure/*.npz
# ------------------------------------------------------------------------------------------
*.laz
*.las
*.tif
*.tiff

# Generated outputs
/figures/
/scratch/
/scratchpad/
/data/csf_cache/

# OS / editor
.DS_Store
*.swp

# py4dgeo writes this automatically
py4dgeo.log
data/las_local/

# Routed-continuity intermediates: large, regenerable with --save
analysis/mass_balance/out/*.npz

# Provenance ledgers written by trust/provenance.py -- one JSON per RUN. These ARE
# tracked (1.2 MB for 140), because README.md, ground_control/FRAME.md, REPORT.md and the
# adopted products cite them BY FILENAME as the record of how each number was produced.
# Ignoring them leaves those citations dangling on a fresh clone and discards the audit
# trail that reconstructed a headline number after its producing script had been deleted.
